# Token del bot de Discord (obligatorio)
DISCORD_TOKEN=tu_token_aqui

# API Key de KLIPY para GIFs (gratis, recomendado)
# Obtenerla en: https://partner.klipy.com  → Sign up → Add Platform → copiar la key
KLIPY_API_KEY=tu_klipy_key_aqui

# Zona horaria (default: America/Lima)
TIMEZONE=America/Lima

# Hora en la que se ejecuta el aviso diario (0-23)
CHECK_HOUR=8

# Mencionar o no a @everyone en los avisos de cumpleaños
MENTION_EVERYONE=true

# Sincronización de slash commands
# Pon SYNC_COMMANDS=1 SOLO cuando agregues o cambies slash commands
# Luego vuelve a 0 para evitar consumir cuota de la API de Discord
SYNC_COMMANDS=0
